# ==============================================================================
# OpsPilot — Environment Configuration Template
# SECURITY NOTICE: Copy to .env for local use. NEVER commit real secrets/tokens.
# ==============================================================================

# --- Application Settings (Developer A) ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# --- PostgreSQL Configuration (App schema: Dev A | Service ops: Dev B) ---
POSTGRES_USER=opspilot_user
POSTGRES_PASSWORD=<CHANGE_ME_LOCAL_DB_PASSWORD>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=opspilot_db
DATABASE_URL=postgresql+psycopg://opspilot_user:<CHANGE_ME_LOCAL_DB_PASSWORD>@localhost:5432/opspilot_db

# --- AI & LLM Orchestration (Developer A) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=<REDACTED_LLM_API_KEY>
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
GRAPH_MAX_STEPS=10

# --- LangSmith Tracing & Evaluation (Developer A) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=<REDACTED_LANGSMITH_API_KEY>
LANGCHAIN_PROJECT=opspilot-dev

# --- Telemetry & Monitoring Integrations (Contracts: Dev A | Infra: Dev B) ---
PROMETHEUS_BASE_URL=http://localhost:9090
ALERTMANAGER_BASE_URL=http://localhost:9093
LOG_BACKEND_BASE_URL=http://localhost:3100
TELEMETRY_TIMEOUT_SECONDS=5
TELEMETRY_MAX_PAYLOAD_BYTES=65536
USE_MOCK_TELEMETRY=true

# --- Remediation & Security Policy (Developer A & B) ---
REMEDIATION_DRY_RUN_ONLY=true
APPROVAL_EXPIRY_MINUTES=30
WEBHOOK_SHARED_SECRET=<CHANGE_ME_WEBHOOK_SECRET>